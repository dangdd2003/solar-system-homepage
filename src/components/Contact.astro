---
import Footer from "./Footer.astro";
import gmailIcon from "../assets/icons/gmail.svg?raw";
import githubIcon from "../assets/icons/github.svg?raw";
import linkedinIcon from "../assets/icons/linkedin.svg?raw";

// Brand icons: Gmail and GitHub from Simple Icons (CC0), LinkedIn from Font Awesome Free (CC BY 4.0).
const links = [
  {
    label: "Gmail",
    value: "dangdoan2206@gmail.com",
    href: "mailto:dangdoan2206@gmail.com",
    icon: gmailIcon,
    brand: "#ea4335"
  },
  {
    label: "GitHub",
    value: "@dangdd2003",
    href: "https://github.com/dangdd2003",
    icon: githubIcon,
    brand: "#ffffff"
  },
  {
    label: "LinkedIn",
    value: "Đăng Đoàn Đình",
    href: "https://www.linkedin.com/in/dangdd2003",
    icon: linkedinIcon,
    brand: "#0a66c2"
  }
];
---

<section id="contact" class="section contact" data-planet-panel="saturn">
  <div class="container contact__inner">
    <h2 class="section__heading contact__heading" data-reveal="@heading">
      <span class="section__num" data-reveal-part="num">
        04.
      </span>{" "}
      <span class="section__title" data-reveal-split>
        Get In Touch
      </span>
    </h2>
    <p class="contact__text" data-reveal="@text">
      Have a question, a project idea, or just want to say hi? Drop me a message on any of these, my
      inbox is always open.
    </p>

    <ul class="contact__links" data-resize-flip-group>
      {links.map(({ label, value, href, icon, brand }) => (
        <li>
          <a
            class="contact__card surface-card"
            data-reveal="@card"
            data-spotlight
            href={href}
            style={`--brand: ${brand}`}
            aria-label={`${label}: ${value}`}
            {...(href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <span
              class="contact__icon"
              data-reveal="@icon"
              data-reveal-delay="140"
              aria-hidden="true"
              set:html={icon}
            />
            <span class="contact__meta">
              <span class="contact__label">{label}</span>
              <span class="contact__value">
                {/* Prefer wrapping an email before its @ over breaking it mid-word */}
                {value.indexOf("@") > 0 ? (
                  <>
                    {value.slice(0, value.indexOf("@"))}
                    <wbr />
                    {value.slice(value.indexOf("@"))}
                  </>
                ) : (
                  value
                )}
              </span>
            </span>
            <svg
              class="contact__arrow"
              data-reveal="@line"
              data-reveal-delay="320"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path pathLength="1" d="M5 11 11 5M6 5h5v5" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <Footer panel />
</section>

<style>
  .contact__inner {
    text-align: center;
    /* Wide enough that three cards fit a full email address on one line */
    max-width: 64rem;
  }

  /* Same numbered heading as the other sections, centered to match this panel */
  .contact__heading {
    justify-content: center;
    margin-bottom: var(--space-md);
    min-width: 0;
    flex-wrap: wrap;
  }

  .contact__heading .section__title {
    min-width: 0;
    /* Break only when a handle can't fit its card at all, never mid-word otherwise */
    overflow-wrap: break-word;
  }

  .contact__text {
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    line-height: 1.65;
    max-width: 35rem;
    margin: 0 auto var(--space-lg);
    /* Planet sits behind the intro on every screen shape, so lift the text off it */
    text-shadow:
      0 1px 14px rgba(0, 0, 0, 0.95),
      0 0 2px rgba(0, 0, 0, 0.8);
  }

  .contact__links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  /* Glass link card: brand icon tile, label + handle, and an arrow that nudges on hover */
  .contact__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    padding: 1rem 1.1rem;
    text-align: left;
    color: var(--color-text);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: var(--card-radius);
    box-shadow: var(--glass-shadow);
  }

  .contact__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    color: var(--color-text);
    background: var(--glass-bg-subtle);
    border: var(--glass-border-subtle);
    transition:
      color 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease;
  }

  /* Inlined brand SVGs carry their own viewBox; size them and paint with the current color */
  .contact__icon :global(svg) {
    display: block;
    width: 1.375rem;
    height: 1.375rem;
    fill: currentColor;
  }

  /* Card lift and focus ring come from .surface-card; these children follow the card's state */
  @media (any-hover: hover) and (any-pointer: fine) {
    :global(:where(html:not([data-input="touch"]))) .contact__card:hover .contact__icon {
      color: var(--brand);
      background: color-mix(in srgb, var(--brand) 14%, transparent);
      border-color: color-mix(in srgb, var(--brand) 45%, transparent);
    }
  }

  .contact__card:focus-visible .contact__icon {
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 14%, transparent);
    border-color: color-mix(in srgb, var(--brand) 45%, transparent);
  }

  .contact__meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Handles wrap instead of truncating so the email stays readable at every card width */
  .contact__value {
    font-size: 0.92rem;
    min-width: 0;
    /* Break only when a handle can't fit its card at all, never mid-word otherwise */
    overflow-wrap: break-word;
  }

  .contact__arrow {
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
    align-self: flex-start;
    color: var(--color-text-muted);
    transition:
      transform 0.3s ease,
      color 0.3s ease;
  }

  @media (any-hover: hover) and (any-pointer: fine) {
    :global(:where(html:not([data-input="touch"]))) .contact__card:hover .contact__arrow {
      color: var(--color-text);
      transform: translate(2px, -2px);
    }
  }

  .contact__card:focus-visible .contact__arrow {
    color: var(--color-text);
    transform: translate(2px, -2px);
  }

  .contact__links li {
    min-width: 0;
  }

  /* Stack the cards on tablets and phones, where three columns would squeeze the handles */
  @media (max-width: 900px) {
    .contact__links {
      grid-template-columns: minmax(0, 1fr);
      max-width: 26.25rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 600px) {
    .contact__card {
      padding: clamp(0.75rem, 3.2vw, 0.85rem) clamp(0.8rem, 3.2vw, 0.9rem);
      gap: clamp(0.6rem, 2.5vw, 0.75rem);
    }

    .contact__icon {
      width: clamp(2.25rem, 10vw, 2.5rem);
      height: clamp(2.25rem, 10vw, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__icon,
    .contact__arrow {
      transition: none;
    }
  }
</style>
